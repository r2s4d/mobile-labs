<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Общая тема приложения: темная Material 3 с зеленым акцентом -->
    <style name="Theme.GpuStore" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorSecondaryContainer">@color/surface_2</item>
        <item name="colorOnSecondaryContainer">@color/text</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorSurfaceVariant">@color/surface_2</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceContainerHigh">@color/surface_2</item>
        <item name="colorOutline">@color/divider</item>
        <item name="colorError">@color/danger</item>
        <item name="colorPrimaryInverse">#4C7A00</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <!-- Карточка-контейнер: скругленная плоская поверхность -->
    <style name="Widget.GpuStore.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Верхняя панель с кнопкой назад -->
    <style name="Widget.GpuStore.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/surface</item>
        <item name="navigationIcon">@drawable/ic_back</item>
        <item name="navigationIconTint">@color/text</item>
        <item name="titleTextColor">@color/text</item>
        <item name="titleTextAppearance">@style/TextAppearance.GpuStore.ToolbarTitle</item>
    </style>

    <style name="TextAppearance.GpuStore.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Текстовые стили: заголовок строки, второстепенный текст, цена -->
    <style name="Text.Title" parent="">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.Secondary" parent="">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Text.Price" parent="">
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Основная кнопка (зеленая) и вторичная (серая) -->
    <style name="Widget.GpuStore.Button" parent="Widget.Material3.Button">
        <item name="android:textSize">16sp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.GpuStore.Button.Secondary" parent="Widget.Material3.Button.TonalButton">
        <item name="android:textSize">16sp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/surface_2</item>
        <item name="android:textColor">@color/text</item>
        <item name="iconTint">@color/accent</item>
    </style>

    <!-- Строка меню на главном экране -->
    <style name="Text.MenuTitle" parent="">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
